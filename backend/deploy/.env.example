# Copy to .env on the server (/opt/bakhi-game-api/.env). Never commit .env.
# Database password, used by both containers.
POSTGRES_PASSWORD=change-me
# Signs the access tokens; at least 32 random characters (openssl rand -base64 48).
Jwt__Secret=change-me-to-at-least-32-random-characters
# Optional: Gmail SMTP for password reset codes. The password is a Google
# "app password" (Google Account > Security > App passwords), not the
# normal Gmail password.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__User=your.account@gmail.com
Smtp__Password=your-16-letter-app-password
Smtp__From=your.account@gmail.com
Smtp__FromName=Bá Khí Game Hub
ASPNETCORE_ENVIRONMENT=Production
